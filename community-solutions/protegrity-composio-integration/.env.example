# ─── Protegrity Developer Edition ────────────────────────────────────────────
DEV_EDITION_EMAIL=your@email.com
DEV_EDITION_PASSWORD=yourpassword
DEV_EDITION_API_KEY=your-protegrity-api-key

# Protegrity local service endpoints (started by docker-compose)
CLASSIFY_URL=http://localhost:8580/pty/data-discovery/v1.1/classify
SGR_URL=http://localhost:8581/pty/semantic-guardrail/v1.1/conversations/messages/scan
DETOKENIZE_URL=http://localhost:8580/pty/data-protection/v1.1/detokenize

# ─── Composio ─────────────────────────────────────────────────────────────────
# >>> UPDATE THIS WITH YOUR OWN COMPOSIO API KEY <<<
#
# This is the ONLY platform credential this app needs. GitHub, Gmail, Slack and
# Google access are all brokered by Composio — never put platform tokens here.
#
# How to get it:
#   1. Sign in at https://dashboard.composio.dev
#   2. Go to  Connect -> Settings -> Sessions & API Key
#   3. Click Copy (or Regenerate for a fresh one) and paste it below
#
# It must be the MCP *consumer* key — it starts with "ck_" and is sent in the
# x-consumer-api-key header. A Developer Platform key (used with x-api-key)
# will NOT work here and fails with 401 APIKey_InvalidAPIKey.
#
# Regenerating in the dashboard invalidates the old key immediately, so if you
# start seeing 401s, copy the current value again.
COMPOSIO_API_KEY=ck_your-composio-consumer-api-key

# Composio Connect MCP endpoint — leave as-is unless Composio changes it.
COMPOSIO_MCP_URL=https://connect.composio.dev/mcp

# Identifies the end user behind the connections. Fine to leave as "default".
COMPOSIO_USER_ID=default

# Connect your platforms (GitHub, Gmail, Slack, Google Sheets/Drive/Docs ...) at
# https://dashboard.composio.dev -> Connect Apps. The app reads that list live.

# ─── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8900
